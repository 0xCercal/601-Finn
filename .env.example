# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Sem estas duas linhas o app roda só neste navegador.
#
# Estes dois valores são públicos por natureza: vão dentro do site publicado e
# podem ficar no repositório. Use a chave "anon" (ou "publishable").
# NUNCA coloque aqui a chave "service_role" (ou "secret").
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
